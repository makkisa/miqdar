rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function owner(uid) { return request.auth != null && request.auth.uid == uid; }
  function numberOrNull(v) { return v == null || (v is number && v >= 0 && v <= 100000); }
  function nutrients(n) { return n.keys().hasOnly(['kcal','protein','carbs','fat']) && numberOrNull(n.kcal) && numberOrNull(n.protein) && numberOrNull(n.carbs) && numberOrNull(n.fat); }
  function product(p) { return p.keys().hasAll(['id','name','basis','nutrients','source','favorite','lastQuantity','portion']) && p.keys().hasOnly(['id','name','basis','nutrients','source','favorite','lastQuantity','portion','barcode','original']) && p.id is string && p.id.size() <= 128 && p.name is string && p.name.size() > 0 && p.name.size() <= 200 && p.basis in ['g','ml'] && nutrients(p.nutrients) && p.source is string && p.source.size() <= 100 && p.favorite is bool && p.lastQuantity is number && p.lastQuantity > 0 && p.lastQuantity <= 100000 && (p.portion == null || (p.portion is number && p.portion > 0)); }
  match /users/{uid}/entries/{id} {
   allow read: if owner(uid);
   allow create, update: if owner(uid) && request.resource.data.keys().hasOnly(['id','product','quantity','date','createdAt','deleted']) && request.resource.data.id == id && product(request.resource.data.product) && request.resource.data.quantity is number && request.resource.data.quantity > 0 && request.resource.data.quantity <= 100000 && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && request.resource.data.createdAt is number && request.resource.data.deleted is bool;
   allow delete: if owner(uid);
  }
  match /users/{uid}/products/{id} {allow read, delete: if owner(uid); allow create, update: if owner(uid) && request.resource.data.id == id && product(request.resource.data);}
 }
}
